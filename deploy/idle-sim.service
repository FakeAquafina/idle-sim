# systemd unit for the always-on village server.
# Install: sudo cp deploy/idle-sim.service /etc/systemd/system/ && sudo systemctl enable --now idle-sim
[Unit]
Description=Idle Village Sim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idlesim
WorkingDirectory=/opt/idle-sim
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Give the server time to save the world on shutdown.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
