# systemd unit for the always-on village server. deploy/install.sh fills in the
# placeholders and installs it; you normally never edit this by hand.
[Unit]
Description=Idle Village Sim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NPM__ run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Secrets live outside the checkout, root-owned, readable by the service user.
EnvironmentFile=-/etc/idle-sim/env
# Give the server time to save the world on shutdown.
TimeoutStopSec=20
# Modest hardening: no privilege escalation, private /tmp, only the data folder writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__DIR__/server/data

[Install]
WantedBy=multi-user.target
