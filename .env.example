# Copy to server/.env and fill in.
ANTHROPIC_API_KEY=
ADMIN_TOKEN=change-me-to-a-long-random-string
SIM_PORT=3000
# Behind Caddy on the same box, bind to 127.0.0.1 so only the proxy (and SSH tunnels) reach Node.
SIM_HOST=0.0.0.0
# Proxies allowed to report the real client address; "loopback" = Caddy on this box.
TRUST_PROXY=loopback
# Admin commands are only accepted from the server's own machine (SSH tunnel or
# scripts/admin.ts). Set ADMIN_REMOTE=1 to allow them from anywhere; never on a public box.
ADMIN_REMOTE=
# Optional notifications (Phase 2+)
NTFY_URL=
DISCORD_WEBHOOK=
# Optional real-world news (Phase 3). Comma-separated RSS/Atom feed URLs and extra blocked words.
# Defaults: BBC World, NPR News, ScienceDaily. Admins can switch news off in the UI.
NEWS_FEEDS=
NEWS_BLOCKLIST=
