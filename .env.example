# Copy to server/.env and fill in.
ANTHROPIC_API_KEY=
ADMIN_TOKEN=change-me-to-a-long-random-string
SIM_PORT=3000
# Optional notifications (Phase 2+)
NTFY_URL=
DISCORD_WEBHOOK=
# Optional real-world news (Phase 3). Comma-separated RSS/Atom feed URLs and extra blocked words.
# Defaults: BBC World, NPR News, ScienceDaily. Admins can switch news off in the UI.
NEWS_FEEDS=
NEWS_BLOCKLIST=
